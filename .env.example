# NEXLINK Server Configuration
# Copy this file to .env and update values for your environment.

# Server
NODE_ENV=development
PORT=3001

# Database
POSTGRES_PASSWORD=nexlink_dev
DATABASE_URL=postgresql://nexlink:nexlink_dev@localhost:5432/nexlink

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Object Storage (MinIO/S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexlink
S3_SECRET_KEY=nexlink_dev
MINIO_ROOT_PASSWORD=nexlink_dev
S3_BUCKET=nexlink-files

# Agent Identity Encryption
# IMPORTANT: Change this to a strong passphrase. Used to encrypt the device private key at rest.
NEXLINK_IDENTITY_PASSPHRASE=change-me-to-a-strong-passphrase

# AI Configuration (optional)
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4

# Frontend
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001/ws
# VITE_DEMO_MODE=false  # ONLY for development — never enable in production
